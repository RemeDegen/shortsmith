# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
# The key needs these permissions: Text to Speech, Voices→Read, Models→Read, User→Read
# A PAID plan is required: the free tier blocks library voices over the API (402)
# and forbids commercial use.
ELEVENLABS_API_KEY=

# Find a voice id with: python3 tools/tts.py voices
ELEVEN_VOICE_ID=
ELEVEN_MODEL_ID=eleven_multilingual_v2

# Voice settings — this is your channel's identity, keep it stable across videos.
# style=0 is deliberate for explanatory content: higher values flatten the calm,
# falling intonation a corrective script needs.
ELEVEN_STABILITY=0.50
ELEVEN_SIMILARITY=0.50
ELEVEN_STYLE=0.0
ELEVEN_SPEED=1.0
